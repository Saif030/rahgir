# EventRoute — local dev env (copy to .env / client/.env / server/.env as needed)

# Mapbox (you provide the real token)
MAPBOX_TOKEN=pk.YOUR_MAPBOX_TOKEN_HERE
VITE_MAPBOX_TOKEN=pk.YOUR_MAPBOX_TOKEN_HERE

# Database — SQLite for local dev (no Docker required).
# For production Postgres, set DATABASE_URL="postgresql://user:pass@host:5432/eventroute"
# and change provider in server/prisma/schema.prisma from "sqlite" to "postgresql".
DATABASE_URL="file:./dev.db"

# Redis — optional locally; server falls back to in-memory cache when unset.
# REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=dev-access-secret-change-me-min-32-chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-min-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173,http://localhost:4173

# Mail (stubbed locally; set real SMTP for broadcast)
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=
# WHATSAPP_PROVIDER=stub
